  "panels": [
    {
      "id": 1,
      "title": "Bars gần đây",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg"
          },
          "rawSql": "SELECT symbol, tf, ts_open AS time, o, h, l, c, v, source FROM bars ORDER BY ts_open DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Số bar theo symbol (24h)",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg"
          },
          "rawSql": "SELECT symbol, count(*) AS bars FROM bars WHERE ts_open > now() - interval '24 hours' GROUP BY symbol ORDER BY 2 DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tin mới nhất",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "pg"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg"
          },
          "rawSql": "SELECT published_at AS time, source, title, symbols, sentiment, url FROM news_items ORDER BY published_at DESC NULLS LAST LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
