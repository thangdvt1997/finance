      "datasource": {
        "type": "postgres",
        "uid": "pg"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg"
          },
          "rawSql": "SELECT ts AS time, country, title, impact, forecast, previous, actual FROM calendar_events WHERE ts > now() - interval '6 hours' AND impact IN ('high','med') ORDER BY ts LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
