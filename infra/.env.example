# Sao chép thành infra/.env rồi đổi giá trị. KHÔNG commit .env.
POSTGRES_USER=ts
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ts
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too
# Địa chỉ publish ra host. Mặc định chỉ localhost; trên VPS đặt sau reverse proxy/TLS hoặc SSH tunnel.
GRAFANA_BIND=127.0.0.1
GATEWAY_BIND=127.0.0.1
GRAFANA_PORT=3000
GATEWAY_PORT=8080
LOG_LEVEL=INFO
USER_AGENT=trading-system/0.1 (contact: you@example.com)
# api-gateway
API_TOKEN=change-me-api-token
# alert-service (Telegram, tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# collectors (nguồn có rủi ro ToS mặc định tắt; xem README từng service)
MARKET_COLLECTOR_ENABLED=true
NEWS_COLLECTOR_ENABLED=true
EXPERT_COLLECTOR_ENABLED=false
TWELVEDATA_API_KEY=
# mt-bridge (READ-ONLY, investor password). Để trống = tắt.
MT_ENABLED=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# web-ui (website theo dõi). Publish ra host chỉ localhost; đặt sau reverse proxy TLS hoặc SSH tunnel. Tạo mật khẩu: services/web-ui/scripts/make-htpasswd.sh <user>
WEB_BIND=127.0.0.1
WEB_PORT=8580
# api-gateway: truy vấn Prometheus (chỉ-đọc) để /v1/system biết service nào up/down. Để trống = suy ra từ sự kiện trên bus.
PROMETHEUS_URL=http://prometheus:9090
# Bật lớp vận hành + công cụ OSS (Gatus/Dozzle/ntfy); xem README mục "Công cụ OSS vận hành"
#COMPOSE_FILE=docker-compose.yml:docker-compose.ops.yml:docker-compose.tools.yml
#APPRISE_URLS=ntfy://ntfy:80/tradingsys-alerts
# Redis ACL (infra/ops/redis_acl_render.sh sinh các giá trị này nếu thiếu; users.acl chỉ chứa sha256)
REDIS_ADMIN_PASSWORD=
REDIS_APP_PASSWORD=
REDIS_GATEWAY_PASSWORD=

# ---- GOI 0 DONG: nguon mien phi, TU BAT khi co key (thieu key -> tat gon, trang He thong hien "Can key"). Xem docs/FREE_STACK.md ----
# Chi can dat key trong infra/.env roi `docker compose -p tradingsys --env-file .env up -d market-collector news-collector`.
# FX doi chieu Dukascopy (OANDA practice token; TrueFX = tai khoan mien phi, giao thuc HTTP khong ma hoa -> dung tai khoan rieng)
OANDA_PRACTICE_TOKEN=
TRUEFX_USER=
TRUEFX_PASS=
# Co phieu/ETF My (Alpaca Free = feed IEX; Tiingo Starter = EOD)
ALPACA_KEY=
ALPACA_SECRET=
TIINGO_TOKEN=
# Tin + entity + sentiment (Marketaux Free: 100 req/ngay, he thong tu gioi han 70/ngay)
MARKETAUX_TOKEN=
# FRED: chuoi vi mo (lai suat, USD index...) chay KHONG can key. FRED_API_KEY (mien phi) chi de bat them 'actual' lich kinh te (news-collector)
FRED_API_KEY=
# Doi chieu nguon gia (Dukascopy vs OANDA/TrueFX/Frankfurter): nguong lech trung vi (bps; 1 bps = 0,01%)
#RECONCILE_THRESHOLD_BPS=8
#RECONCILE_FRANKFURTER_BPS=25
#RECONCILE_ENABLED=true
