REDIS_URL=redis://redis:6379/0
PORT=8000
# Để trống token/chat id => chỉ ghi log (kênh 'log')
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEDUPE_WINDOW_S=300
RATE_LIMIT_PER_MIN=20
DIGEST_INTERVAL_S=60
RULES_FILE=/app/rules.yaml
ROUTES_FILE=/app/routes.yaml
LOG_LEVEL=INFO
# Apprise: kênh đa dịch vụ (phân tách bằng dấu phẩy). Ví dụ ntfy nội bộ + Slack:
#   APPRISE_URLS=ntfy://ntfy:80/tradingsys-alerts,slack://TokenA/TokenB/TokenC
# Dịch vụ khác: https://github.com/caronc/apprise/wiki . Để trống = tắt.
APPRISE_URLS=
