SERVICE_NAME=news-collector
REDIS_URL=redis://redis:6379/0
PORT=8000
LOG_LEVEL=INFO
# BAT BUOC: User-Agent ro rang co email lien he that (SEC EDGAR chan UA khong co email)
USER_AGENT=trading-system-news/0.1 (contact: you@example.com)

NC_CONFIG_DIR=./config
# Bat/tat tung nguon (true/false)
NC_SRC_RSS=true
NC_SRC_GDELT=true
NC_SRC_CAL_OFFICIAL=true
# Fair Economy / ForexFactory JSON (forecast/previous): BAT mac dinh cho he thong ca nhan noi bo. CANH BAO ToS: chi dung ca nhan,
# khong phan phoi lai/thuong mai (xem README). Dat false de tat.
NC_SRC_CAL_FAIRECONOMY=true
# 'actual' tu API co quan thong ke (BLS/StatCan/ONS/ABS/Eurostat; khong can key). Key tuy chon:
NC_SRC_CAL_ACTUALS=true
# BLS_API_KEY=      # mien phi, nang tran BLS 25 -> 500 req/ngay
# FRED_API_KEY=     # mien phi, bat them chi so FRED (ban le, san xuat cong nghiep My)
# Alert cua so rui ro tin (T-30 / vao / ra); false = alert cu 'HIGH sap toi'
NC_RISK_ALERTS=true
# Lich quyet dinh lai suat ECB/BoE/BoJ (trang chinh thuc cua NHNW) - BAT
NC_SRC_CAL_CENTRAL_BANKS=true
# FMP economic calendar (forecast/previous/actual quoc te): can key MIEN PHI, mac dinh TAT, chua kiem chung voi key that
NC_SRC_CAL_FMP=false
# FMP_API_KEY=
NC_SRC_COT=true
# SEC 13F: can USER_AGENT co email; mac dinh TAT
NC_SRC_SEC13F=false

# Chu ky poll (giay)
NC_RSS_INTERVAL=900
NC_GDELT_INTERVAL=900
NC_CAL_INTERVAL=3600
NC_COT_INTERVAL=21600
NC_SEC13F_INTERVAL=43200
# Canh bao su kien HIGH impact sap toi (phut) va chu ky kiem tra (giay)
NC_ALERT_WINDOW_MIN=30
NC_ALERT_CHECK_INTERVAL=60
# TTL dedupe trong Redis (giay)
NC_DEDUPE_TTL=2592000

# Marketaux Free (tin + entity + sentiment): TU BAT khi co token; toi da MARKETAUX_DAILY_BUDGET request/ngay (free 100)
# MARKETAUX_TOKEN=
# MARKETAUX_DAILY_BUDGET=70
# NC_SRC_NEWS_MARKETAUX=true
# NC_MARKETAUX_INTERVAL=1200
