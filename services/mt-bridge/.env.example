SERVICE_NAME=mt-bridge
PORT=8000
REDIS_URL=redis://redis:6379/0
BRIDGE_CONFIG=/config/accounts.yaml
# BAT BUOC: Bearer token cho GET /accounts. De trong -> /accounts tra 503 (fail-closed).
BRIDGE_ADMIN_TOKEN=
# Chi cho dev local: 1 = cho phep /accounts khong token
# BRIDGE_ADMIN_INSECURE_DEV=1
BRIDGE_SKEW_S=120
BRIDGE_MT5_POLL_S=5
BRIDGE_MONITOR_S=10
# Moi tai khoan: bien moi truong tham chieu trong accounts.yaml (dat gia tri that ngoai repo)
# MT_TOKEN_DEMO_MT4_01=
# MT5_INVESTOR_PASSWORD_01=# Cap phat dong tu service auth (de trong = chi accounts.yaml). BRIDGE_AUTH_TOKEN = cung gia tri voi token noi bo ben auth
# BRIDGE_AUTH_URL=http://auth:8000
# BRIDGE_AUTH_TOKEN=
# BRIDGE_AUTH_TTL_S=15
# BRIDGE_RATE_PER_S=5
