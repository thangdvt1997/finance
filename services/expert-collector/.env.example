SERVICE_NAME=expert-collector
PORT=8010
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
USER_AGENT=trading-system-expert-collector/0.1 (contact: you@example.com)
ENABLED=true

# Nguon bat (mac dinh chi nguon rui ro thap). Xem SOURCES.md
EC_SOURCES=rss_ideas,static_json
EC_POLL_SECONDS=300
EC_HTTP_MIN_INTERVAL=2.0
EC_HTTP_CACHE_TTL=120
EC_RESPECT_ROBOTS=true

# rss_ideas: JSON list [{"expert_id":"...","name":"...","url":"https://.../feed.xml","kind":"idea|vn_report"}]
EC_RSS_FEEDS=[]
# static_json: file JSON do ban tu bien soan (xem README)
EC_STATIC_JSON_PATH=

# Nguon RUI RO ToS - tat mac dinh. Bat can CA hai: them vao EC_SOURCES va dat *_ACCEPT_TOS=true
EC_MQL5_ACCEPT_TOS=false
EC_MQL5_URLS=
# Myfxbook: chi tai khoan CUA BAN qua API chinh thuc
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Nguong uy tin
EC_MIN_MONTHS=6
EC_MAX_DRAWDOWN_PCT=40
EC_MIN_GAIN_PCT=0
EC_MIN_FOLLOWERS=0
EC_MIN_SCORE=50
EC_REJECT_MARTINGALE=true

# Dong thuan
EC_CONSENSUS_MIN_EXPERTS=3
EC_CONSENSUS_MIN_RATIO=0.7
EC_STANCE_WINDOW_HOURS=72
