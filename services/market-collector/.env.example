# --- chung ---
SERVICE_NAME=market-collector
PORT=8010
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
USER_AGENT=trading-system-market-collector/0.1 (contact: you@example.com)

# --- provider bat/tat (danh sach, phan cach dau phay) ---
PROVIDERS=dukascopy,frankfurter,vnstock,twelvedata
# stooq/yahoo co rui ro ToS: phai VUA liet ke trong PROVIDERS VUA dat ALLOW_RISKY_PROVIDERS=true
ALLOW_RISKY_PROVIDERS=false

# --- symbol theo provider ---
DUKASCOPY_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
FRANKFURTER_SYMBOLS=EURUSD,GBPUSD,USDJPY
VNSTOCK_SYMBOLS=VN:VNM,VN:FPT,VN:VCB
TWELVEDATA_SYMBOLS=
TWELVEDATA_TFS=H1,D1
STOOQ_SYMBOLS=
YAHOO_SYMBOLS=

# --- khoa API (de trong = provider tuong ung tu tat / giam han muc) ---
TWELVEDATA_API_KEY=
VNSTOCK_API_KEY=

# --- nen ---
OUTPUT_TFS=M1,M5,M15,H1,H4,D1
BACKFILL_ON_START=true
BACKFILL_DAYS=7
POLL_INTERVAL_DUKASCOPY=60
POLL_INTERVAL_FRANKFURTER=3600
POLL_INTERVAL_VNSTOCK=900
POLL_INTERVAL_TWELVEDATA=300
EMPTY_ALERT_AFTER=6
ERROR_ALERT_AFTER=5
BACKFILL_RETRY_BASE=120
BACKFILL_RETRY_MAX=1800
DUKASCOPY_RATE_PER_SEC=2
DUKASCOPY_CONCURRENCY=2

# --- cache/state ---
CACHE_DIR=/data/cache
STATE_FILE=/data/state.json

# --- endpoint POST /backfill (de trong = vo hieu) ---
BACKFILL_TOKEN=

# Lap day gap (xem README)
# GAP_SCAN_INTERVAL=900
# GAP_SCAN_DAYS=7
# GAP_FILL_PER_CYCLE=3
# GAP_ALERT_AFTER=21600
