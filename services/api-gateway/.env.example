REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://ts_reader:CHANGE_ME@timescaledb:5432/ts
PORT=8000
# Danh sách API token, phân tách bằng dấu phẩy. Để trống => MỌI request /v1 bị từ chối (fail-closed).
API_TOKENS=
# Chỉ dùng khi dev cục bộ:
AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:3000
MAX_PAGE_SIZE=1000
WS_MAX_CONNECTIONS=100
LOG_LEVEL=INFO
# /v1/system: truy vấn Prometheus (chỉ-đọc) để biết service nào up/down. Để trống = suy ra từ sự kiện cuối trên Redis Streams.
PROMETHEUS_URL=http://prometheus:9090

# Mac dinh true: phan hoi /v1/* khong chua ten nguon du lieu (docs/UI_NO_SOURCES.md). false = debug.
HIDE_SOURCES=true
